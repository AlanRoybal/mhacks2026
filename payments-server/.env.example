STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Required for POST /stripe/webhook. Use the whsec_ value from stripe listen.
STRIPE_WEBHOOK_SECRET=
HOST=127.0.0.1
PORT=4242
# URL reachable by the iPhone browser for Connect return/refresh callbacks.
BOUNTY_PUBLIC_URL=http://127.0.0.1:4242
# npm run setup:chain generates the following in ignored .env.chain instead.
BOUNTY_ADMIN_TOKEN=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ESCROW_ARBITER_PRIVATE_KEY=
ESCROW_CONTRACT_ADDRESS=
ESCROW_DEPLOYMENT_BLOCK=0
