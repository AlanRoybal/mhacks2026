# Copy to .env. Everything is optional for `npm run dev`; the defaults run fully offline.
# For `npx cdk deploy`, these values are copied into the Lambda environment.

# --- General ---
# DEMO_MODE=true shortens every timer (30 s offers, 2 min review window) and mounts /demo routes.
DEMO_MODE=true
# On a deployed stage, demo login and /demo routes also require the header `x-demo-key: <this>`.
# Leave empty to turn them off there. Never share it outside the team.
DEMO_LOGIN_KEY=
# Required outside local dev. Any long random string: `openssl rand -hex 32`
JWT_SECRET=
# Comma-separated user IDs that may resolve disputes (demo login "admin" is an admin in local dev only).
ADMIN_USER_IDS=

# --- Local dev server ---
PORT=8787
# Must be reachable by the phone: use your laptop's LAN IP or an ngrok/cloudflared URL when testing on a device.
PUBLIC_BASE_URL=http://localhost:8787
# Where the in-memory store, timers and uploads are saved. Delete the folder to start fresh.
DATA_DIR=.data

# --- AI ---
# fake (offline heuristics) | anthropic (Claude API) | bedrock (Claude on Amazon Bedrock)
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 (anthropic.claude-opus-5-5 on Bedrock)
AI_MODEL=
# hash (offline) | titan (Titan Text Embeddings v2 on Bedrock)
EMBED_PROVIDER=hash

# --- Payments ---
# fake (instant, nothing charged) | stripe (test mode keys)
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8787/webhooks/stripe` locally, or the dashboard endpoint when deployed.
STRIPE_WEBHOOK_SECRET=

# --- Push (APNs) ---
# console (log only) | apns
PUSH_PROVIDER=console
APNS_KEY_ID=
APNS_TEAM_ID=DVX8YZ9GG9
# Contents of AuthKey_XXXXXXXXXX.p8 (literal \n line breaks are fine)
APNS_KEY_P8=

# --- Sign-in ---
APPLE_BUNDLE_ID=com.alanroybal.BountyTwin
# The URL scheme the app registers (bounty://oauth/linkedin, bounty://stripe-redirect, ...).
APP_URL_SCHEME=bounty
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Live job sessions (SpacetimeDB) ---
# memory (in process, default) | spacetime (the bounty-live module in ../spacetime, published to Maincloud)
LIVE_PROVIDER=memory
SPACETIME_URL=https://maincloud.spacetimedb.com
SPACETIME_DB=bounty-live
# The token of the SpacetimeDB identity that published bounty-live (see ../spacetime/README.md).
SPACETIME_TOKEN=
