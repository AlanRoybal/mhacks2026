<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>BountyPaymentsBaseURL</key>
    <string>$(BOUNTY_PAYMENTS_BASE_URL)</string>
    <key>BountyApplePayMerchantIdentifier</key>
    <string>$(BOUNTY_APPLE_PAY_MERCHANT_IDENTIFIER)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>com.alanroybal.BountyTwin.payments</string>
            <key>CFBundleURLSchemes</key><array><string>bounty</string></array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Bounty connects to the local payment test server during development.</string>
</dict>
</plist>
